# --- App / DB ---
FETCHR_DATABASE_URL=sqlite:///./fetchr.db
FETCHR_TMP_DIR=./tmp

# --- Rolling code auth ---
# The hardcoded first code. Only its hash is stored, on first startup.
FETCHR_CLIENT_ID=my-client
FETCHR_SEED_CODE=change-me
# Window in which the previous code is still accepted once (lost-response recovery)
FETCHR_CODE_GRACE_SECONDS=60

# --- Downloads ---
# Optional Netscape-format cookies file for Facebook videos that need login
FETCHR_COOKIES_FILE=
# Upload + verify attempts before marking a download failed
FETCHR_UPLOAD_RETRIES=3

# --- Backblaze B2 (S3-compatible) ---
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Seconds a presigned download link stays valid
B2_PRESIGN_EXPIRY=3600
